rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function oficinaAutorizada() {
      return request.auth != null && request.auth.uid == 'FZImyDvFT0TE36g27EhzzpCj7Jo2';
    }
    match /ordens_servico/{id} {
      allow read, write: if oficinaAutorizada();
    }
    match /estoque_pecas/{id} {
      allow read, write: if oficinaAutorizada();
    }
    match /servicos_avulsos/{id} {
      allow read, write: if oficinaAutorizada();
    }
    match /garantias_publicas/{codigo} {
      allow get: if codigo.matches('^[0-9a-f]{48}$');
      allow list: if false;
      allow create, update, delete: if oficinaAutorizada();
    }
  }
}
